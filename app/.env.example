# Frontend Vite env vars. Build-time substitution; safe to commit.

# Entra ID — match the values used by the backend (api/.env).
# MSAL is configured for `loginRedirect`. The redirect URI registered in
# the Entra app reg's SPA platform MUST be `${origin}/auth/login/callback`
# (e.g. `http://localhost:5174/auth/login/callback` in dev — Vite serves
# on 5174, NOT 5173).
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=

# Where the backend serves. Trailing slash NOT required.
VITE_API_BASE=http://localhost:8000
