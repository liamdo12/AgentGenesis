    },
    {
      "id": "z_sse_s",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 797012636,
      "version": 1,
      "versionNonce": 199722482,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "type": "text",
      "x": 2094,
      "y": 1422,
      "width": 222,
      "height": 428,
      "text": "1. POST /chat (Bearer)\n\n2. acquire per-run Lock\n   load latest revision\n   + chat history (\u226450)\n\n3. Synthesizer.stream_chat\n   yields text deltas\n   + fenced ag-stories\n\n4. \u22641 deletion \u2192 auto\n   commit_revision\n   >1 \u2192 revision_preview\n        gate w/ accept POST\n\n5. BackgroundTask\n   finalizes turn (always)\n\n6. heartbeat\n   ': keep-alive' / 15 s",
      "originalText": "1. POST /chat (Bearer)\n\n2. acquire per-run Lock\n   load latest revision\n   + chat history (\u226450)\n\n3. Synthesizer.stream_chat\n   yields text deltas\n   + fenced ag-stories\n\n4. \u22641 deletion \u2192 auto\n   commit_revision\n   >1 \u2192 revision_preview\n        gate w/ accept POST\n\n5. BackgroundTask\n   finalizes turn (always)\n\n6. heartbeat\n   ': keep-alive' / 15 s",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "lineHeight": 1.55,
      "containerId": null
    },
