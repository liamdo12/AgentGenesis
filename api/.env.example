# Deployment environment. Production refuses to boot with use_stub_nodes=true.
AG_ENVIRONMENT=dev

# ─── Microsoft Entra ID (required when AG_USE_STUB_NODES != 1) ────────────────
# Tenant GUID. Azure portal → Entra ID → Overview → "Tenant ID".
AG_ENTRA_TENANT_ID=
# App registration "Application (client) ID" GUID. Doubles as the v2 access
# token audience (we validate with this value, not the App ID URI).
AG_ENTRA_CLIENT_ID=
# Backend client secret from the same app registration (NOT shared with the
# frontend). Used for the On-Behalf-Of token exchange in Phase 3.
AG_ENTRA_CLIENT_SECRET=

# ─── Anthropic ────────────────────────────────────────────────────────────────
AG_ANTHROPIC_API_KEY=

# ─── Teams MCP (DEPRECATED — removed in Phase 4 of the SSO plan) ──────────────
# Kept for now so the existing TeamsMCPClient compiles during the phased rollout.
# Leave default; will be deleted along with TeamsMCPClient.
# AG_TEAMS_MCP_URL=http://localhost:3000/mcp
# AG_TEAMS_MCP_AUTH_TOKEN=

# ─── Optional overrides (defaults shown) ──────────────────────────────────────
# AG_DATA_DIR=./data
# AG_CLAUDE_MODEL=claude-sonnet-4-6
# AG_FRAME_INTERVAL_SEC=30
# AG_CHUNK_WINDOW_SEC=600
# AG_MAX_PARALLEL_FFMPEG=4
# AG_MIN_USEFUL_FRAMES=3
# AG_SYNTH_MAX_INPUT_TOKENS=150000
# AG_SYNTH_CHUNK_OVERLAP_SEC=30
# AG_LOG_FORMAT=console

# ─── Test / dev only ──────────────────────────────────────────────────────────
# Bypasses Entra ID and external services for tests + design-QA frontend runs.
# REFUSED at boot when AG_ENVIRONMENT=prod (per red-team Finding 6).
# AG_USE_STUB_NODES=1
